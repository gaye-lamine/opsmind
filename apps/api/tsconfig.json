{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "types": ["node"],
    "paths": {
      "@opsmind/agent":      ["../../packages/agent/src/index.ts"],
      "@opsmind/ai":         ["../../packages/ai/src/index.ts"],
      "@opsmind/config":     ["../../packages/config/src/index.ts"],
      "@opsmind/mcp-client": ["../../packages/mcp-client/src/index.ts"],
      "@opsmind/memory":     ["../../packages/memory/src/index.ts"],
      "@opsmind/shared":     ["../../packages/shared/src/index.ts"],
      "@opsmind/tools":      ["../../packages/tools/src/index.ts"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
