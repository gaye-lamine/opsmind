{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@opsmind/config": ["../packages/config/src/index.ts"],
      "@opsmind/memory": ["../packages/memory/src/index.ts"],
      "@opsmind/shared": ["../packages/shared/src/index.ts"],
      "@opsmind/tools":  ["../packages/tools/src/index.ts"],
      "@opsmind/ai":     ["../packages/ai/src/index.ts"]
    }
  },
  "include": ["**/*"]
}
