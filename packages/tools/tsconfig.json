{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "paths": {
      "@opsmind/ai": ["../ai/src/index.ts"],
      "@opsmind/config": ["../config/src/index.ts"],
      "@opsmind/shared": ["../shared/src/index.ts"],
      "@opsmind/memory": ["../memory/src/index.ts"],
      "@opsmind/mcp-client": ["../mcp-client/src/index.ts"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "mongodb/**/*",
    "mongodb-mcp/**/*",
    "analytics/**/*",
    "business/**/*",
    "actions/**/*",
    "registry/**/*"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../ai" },
    { "path": "../config" },
    { "path": "../shared" },
    { "path": "../memory" },
    { "path": "../mcp-client" }
  ]
}
