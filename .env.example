# OpsMind Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=your_value_here
PORT=your_value_here

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Required: MongoDB Atlas or local connection string
MONGODB_URI=your_value_here
MONGODB_DB_NAME=your_value_here

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Mode 1 (default): Google AI Studio — requires GEMINI_API_KEY
# Mode 2: Vertex AI with ADC — set USE_VERTEX_AI=your_value_here
#   Run: gcloud auth application-default login
#   Then set GOOGLE_CLOUD_PROJECT_ID to your project
USE_VERTEX_AI=your_value_here
# GEMINI_API_KEY not needed with Vertex AI ADC
GEMINI_MODEL=your_value_here
GEMINI_MAX_TOKENS=your_value_here
GEMINI_TEMPERATURE=your_value_here

# ─── Google Cloud ─────────────────────────────────────────────────────────────
# Required when USE_VERTEX_AI=your_value_here
GOOGLE_CLOUD_PROJECT_ID=your_value_here
GOOGLE_CLOUD_LOCATION=your_value_here
# GOOGLE_APPLICATION_CREDENTIALS=your_value_here

# ─── Agent Runtime ────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=your_value_here
AGENT_REFLECTION_ENABLED=your_value_here
AGENT_CONFIDENCE_THRESHOLD=your_value_here
AGENT_MEMORY_RETRIEVAL_LIMIT=your_value_here

# ─── API ──────────────────────────────────────────────────────────────────────
API_BASE_URL=your_value_here
WEB_BASE_URL=your_value_here
CORS_ORIGINS=your_value_here

# ─── MongoDB Atlas MCP Server ─────────────────────────────────────────────────
# Service account credentials for the official MongoDB MCP Server
# Used by packages/mcp-client to connect to MongoDB Atlas tools
ATLAS_MCP_CLIENT_ID=your_value_here
ATLAS_MCP_CLIENT_SECRET=your_value_here

# ─── Vector Memory ────────────────────────────────────────────────────────────
VECTOR_SEARCH_ENABLED=your_value_here
VECTOR_DIMENSIONS=your_value_here
