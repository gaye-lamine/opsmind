{
  "name": "@opsmind/tools",
  "version": "1.0.0",
  "description": "OpsMind action capability layer — MCP tools, tool registry, MongoDB integrations",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "@opsmind/ai": "workspace:*",
    "@opsmind/config": "workspace:*",
    "@opsmind/mcp-client": "workspace:*",
    "@opsmind/memory": "workspace:*",
    "@opsmind/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
